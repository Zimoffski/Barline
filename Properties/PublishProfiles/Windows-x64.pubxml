<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- A regular folder, not a single-file bundle: a WPF single-file app extracts native
         libraries (wpfgfx, PresentationNative, D3DCompiler) into the user's %TEMP% and loads
         them from there. Any unelevated process could plant a DLL in that folder and run code
         inside the elevated monitor. Installed into Program Files, every file stays protected. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>$(MSBuildProjectDirectory)\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
