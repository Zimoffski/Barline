<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Barline.ico</ApplicationIcon>
    <AssemblyName>Barline</AssemblyName>
    <RootNamespace>Barline</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>3.4.0</Version>
    <FileVersion>3.4.0.0</FileVersion>
    <AssemblyVersion>3.4.0.0</AssemblyVersion>
    <Product>Barline</Product>
    <AssemblyTitle>Barline — мониторинг системы</AssemblyTitle>
    <Description>Компактный монитор CPU, GPU, RAM, FPS и сети для панели задач Windows.</Description>
    <Authors>Zimoffski</Authors>
    <Company>Zimoffski</Company>
    <Copyright>© 2026 Zimoffski</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Downloaded by scripts/Get-Dependencies.ps1; without it the app runs, only FPS stays "—". -->
    <Content Include="Assets\PresentMon-2.5.1-x64.exe" Condition="Exists('Assets\PresentMon-2.5.1-x64.exe')">
      <Link>PresentMon-2.5.1-x64.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
